#!/bin/bash

bin=`dirname "$0"`
BIGDEC_HOME=`cd "$bin"/..; pwd`

function help()
{
        echo "";
        echo "Usage: flinkrun --args \"BIGDEC_ARGS\" [FLINK_ARGS]";
        echo "";
        exit 127
}

nargs=$#

while [[ nargs -gt 0 ]]
 do
  case "$1" in
        --args)
            BIGDEC_ARGS=( "$2" )
            shift
		shift
		nargs=$((nargs-2))
                ;;
	*)
		FLINK_ARGS+=("$1")
		shift
		nargs=$((nargs-1))
		;;
  esac
done

if [ -z "$BIGDEC_ARGS" ]; then
        help
fi

# Logging configuration for Flink
LOG_CONF="$BIGDEC_HOME/conf/log4j2.properties"
LOG_ARGS=""
if [ -f "$LOG_CONF" ]; then
    LOG_ARGS="-Denv.java.opts=-Dlog4j2.configurationFile=$LOG_CONF"
fi

# Restore positional parameters
set -- "${FLINK_ARGS[@]}"

echo "flink run $LOG_ARGS "$@" --class es.udc.gac.bigdec.RunEC $BIGDEC_HOME/target/bigdec-bin.jar flink ${BIGDEC_ARGS}"
flink run $LOG_ARGS "$@" --class es.udc.gac.bigdec.RunEC $BIGDEC_HOME/target/bigdec-bin.jar flink ${BIGDEC_ARGS}
