#!/bin/bash

bin=`dirname "$0"`
BIGDEC_HOME=`cd "$bin"/..; pwd`

function help()
{
        echo "";
        echo "Usage: sparkrun --args \"BIGDEC_ARGS\" [SPARK_ARGS]";
        echo "";
        exit 127
}

nargs=$#

while [[ nargs -gt 0 ]]
 do
  case "$1" in
        --args)
            BIGDEC_ARGS=( "$2" )
            shift
		shift
		nargs=$((nargs-2))
                ;;
	*)
		SPARK_ARGS+=("$1")
		shift
		nargs=$((nargs-1))
		;;
  esac
done

if [ -z "$BIGDEC_ARGS" ]; then
        help
fi

# Logging configuration
LOG_CONF="$BIGDEC_HOME/conf/log4j2.properties"
LOG_ARGS=""
if [ -f "$LOG_CONF" ]; then
	# The driver uses the local absolute path, the executors use the distributed file
    LOG_ARGS="--files $LOG_CONF --conf spark.driver.extraJavaOptions=-Dlog4j2.configurationFile=file://$LOG_CONF --conf spark.executor.extraJavaOptions=-Dlog4j2.configurationFile=log4j2.properties"
fi

# Restore positional parameters
set -- "${SPARK_ARGS[@]}"

echo "spark-submit $LOG_ARGS "$@" --class es.udc.gac.bigdec.RunEC $BIGDEC_HOME/target/bigdec-bin.jar spark ${BIGDEC_ARGS}"
spark-submit $LOG_ARGS "$@" --class es.udc.gac.bigdec.RunEC $BIGDEC_HOME/target/bigdec-bin.jar spark ${BIGDEC_ARGS}
